# Copy this file to .env.local and replace every placeholder locally.
# Never commit .env.local or any real credential.
NODE_ENV=development
SERVER_PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

# Runtime uses the restricted application role.
DATABASE_URL=postgresql://tapra2_app:<APP_PASSWORD>@localhost:5432/tapra2_dev
# Migrations use the non-superuser database owner role.
DATABASE_MIGRATION_URL=postgresql://tapra2_owner:<OWNER_PASSWORD>@localhost:5432/tapra2_dev
TEST_DATABASE_URL=postgresql://tapra2_app:<APP_PASSWORD>@localhost:5432/tapra2_test
TEST_DATABASE_MIGRATION_URL=postgresql://tapra2_owner:<OWNER_PASSWORD>@localhost:5432/tapra2_test

# Docker Compose only. Use generated local secrets; these are intentionally placeholders.
POSTGRES_ADMIN_PASSWORD=<DOCKER_ADMIN_PASSWORD>
POSTGRES_OWNER_PASSWORD=<OWNER_PASSWORD>
TAPRA2_APP_PASSWORD=<APP_PASSWORD>

SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
LOG_LEVEL=info

GEMINI_API_KEY=
